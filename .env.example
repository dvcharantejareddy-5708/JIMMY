# ==========================================
# JIMMY — Open Source Assistant Environment
# ==========================================

PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Google Cloud Vertex AI / ADC Configuration (ADC Only - No API Keys)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GEMMA_MODEL=

# GitHub App Integration
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CALLBACK_URL=

# Session Security
SESSION_SECRET=
APP_BASE_URL=

# Graphify Sandbox Configuration
GRAPHIFY_SANDBOX_DIR=./temp/sandboxes
GRAPHIFY_TIMEOUT_MS=60000
GRAPHIFY_MAX_REPO_MB=50
